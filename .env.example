# SRSZQ.com 环境变量示例（复制为 .env 后按需修改）
# 后端（backend/src/server.ts 读取）
PORT=8080
SRSZQ_WS_PORT=8081
SRSZQ_QUEUE_TIMEOUT_MS=60000
SRSZQ_AI_DELAY_MS=350
SRSZQ_DISCONNECT_SKIP_MS=30000
# Online Match 掉线判负宽限期（ms）：断线后此时间内返回（resume）恢复对局，超时判负
SRSZQ_FORFEIT_GRACE_MS=10000

# 前端构建期注入（docker 构建参数同名）
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8081/ws

SRSZQ_INVITE_GATHER_MS=30000

# ---- P0A 显式功能开关（默认全部关闭；只有 1/true/on/yes 才视为开启）----
# 新评分公式 Beta（P1 实现）。关闭时使用历史 legacy-online-v1 积分口径。
SRSZQ_RATING_BETA=false
# Invitus 影子运行（研究模型并行评估，不参与对局决策）。
SRSZQ_INVITUS_SHADOW=false
